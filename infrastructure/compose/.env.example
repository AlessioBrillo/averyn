# Copy to .env (git-ignored) and change every value marked CHANGE.
POSTGRES_DB=averyn
POSTGRES_USER=averyn
POSTGRES_PASSWORD=CHANGE-me-to-a-long-random-string

# Identity provider (Zitadel, ADR-0011). The issuer is http://IDP_HOST:IDP_PORT and must be reachable under that
# exact name from the phone/browser AND from the backend container (the Compose network alias covers the latter).
#   - desktop browser on the same machine: idp.localhost resolves to loopback automatically
#   - phone / emulator: use <host-lan-ip>.nip.io (Android emulator: 10.0.2.2.nip.io) and set AVERYN_BIND=0.0.0.0
IDP_HOST=idp.localhost
IDP_PORT=8081
# Exactly 32 characters, never change after first start (encrypts secrets inside the IdP).
ZITADEL_MASTERKEY=CHANGE-me-needs-exactly-32-chars
ZITADEL_DB_PASSWORD=CHANGE-me-to-a-long-random-string
# Password of the IdP console admin (login name: admin@zitadel.<IDP_HOST>). Must satisfy the default policy.
ZITADEL_ADMIN_PASSWORD=CHANGE-Me-1-to-a-strong-password

# Optional: host port of the backend (default 8080) and the interface the backend and IdP bind to
# (default 127.0.0.1; 0.0.0.0 exposes them on the LAN, including the unauthenticated /metrics: dev only).
# BACKEND_PORT=8080
# AVERYN_BIND=127.0.0.1

# Optional: web app (TDD-0003). WEB_ORIGIN is the exact URL users open it at (the IdP redirect is registered with it
# the first time the stack starts); the default is http://localhost:WEB_PORT.
# WEB_PORT=8082
# WEB_ORIGIN=http://localhost:8082
# Basemap: a MapLibre style URL. Unset = a demo style. Whoever serves the tiles sees which areas users view.
# AVERYN_MAP_STYLE_URL=

# Optional: S3 credentials the backend uses for the object store. They must match infrastructure/compose/seaweedfs-s3.json
# (the defaults below are the development values in that file): change both before exposing the stack.
# S3_ACCESS_KEY=averyn-dev-access
# S3_SECRET_KEY=averyn-dev-secret-change-me
